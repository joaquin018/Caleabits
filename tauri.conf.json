{
  "productName": "Caleabits",
  "version": "0.1.0",
  "identifier": "com.caleabits.tauri",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "./src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
